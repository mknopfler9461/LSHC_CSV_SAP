# Optional confined authority helper model.
# Leave unset to use the deterministic local authority-cache answer.

# AUTHORITY_CHAT_PROVIDER can be gemini, deepseek, or local.
AUTHORITY_CHAT_PROVIDER=local

# Gemini REST API
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# DeepSeek REST API
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
